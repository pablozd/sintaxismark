%% sintaxismark.sty  v0.6.22 (2026-06-28)
%% CHANGE v0.6.22: Add manual multi-line helpers for split spans and boxes:
%%   \spanfirst, \spanmid, \spanlast; \boxfirst, \boxmid, \boxlast.
%%   Add shortcut wrappers \SESfirst/\SESmid/\SESlast and analogous
%%   commands for ST, SEC, PVS, PVC, and OS.
%% CHANGE v0.6.21: \tagbelow ahora encadena profundidad con \syn@reportdepth/
%%   \syn@childmaxd (igual que \openbox), así las etiquetas de \tagbelow
%%   anidados (p.ej. MI dentro de OD) ya no se superponen entre sí ni con
%%   etiquetas de la línea siguiente. Ajustada la reserva fija del modo
%%   compacto extremo: \syn@reserveabove 4ex → 7.5ex.
%% CHANGE v0.6.20: Limpieza interna — quitado \textsc{} duplicado en atajos de
%%   \spanline (SES, ST, SEC, PVS, PVC, OS); unificados los bloques
%%   \makeatletter/\makeatother de openbox/spanline y del modo compacto;
%%   eliminadas líneas huérfanas del header y de fin de archivo.
%% CHANGE v0.6.19: Comandos duales (sin estrella=tagbelow, con estrella=openbox)
%%   para OD, OI, CCL, COMP, MD, MI, CAg, CREG, CSim, CL, CM,
%%   PSO, PSNO, POO, PONO, ACT, ACL, ACM, ACF, ACC, ACCant, ACI, ACFin,
%%   MG, Ap, MF, IPCR, Incl.
%%   Eliminados: \ODP, \OIP (reemplazados por \OD y \OI sin estrella).
%% CHANGE v0.6.18: Render ALL labels/tags in small caps via \textsc{}
%% CHANGE v0.6.17: Increase default tagy for tagbelow labels (global and in presets)
\NeedsTeXFormat{LaTeX2e}

