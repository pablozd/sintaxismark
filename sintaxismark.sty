%% sintaxismark.sty  v0.7.0 experimental (2026-06-29)
%% Integrated entry point: classic mode + experimental grid mode.
%% Classic implementation is kept in sintaxismark-classic.sty.
%% Grid implementation is loaded from sintaxismark-grid.sty.

\NeedsTeXFormat{LaTeX2e}

\InputIfFileExists{sintaxismark-classic.sty}{}{%
  \PackageError{sintaxismark}{Required file sintaxismark-classic.sty not found}{%
    Put sintaxismark-classic.sty in the same directory as sintaxismark.sty.}%
}

\IfFileExists{sintaxismark-grid.sty}{%
  \RequirePackage{sintaxismark-grid}%
}{%
  \PackageWarning{sintaxismark}{sintaxismark-grid.sty not found; experimental grid mode is not available}%
}
